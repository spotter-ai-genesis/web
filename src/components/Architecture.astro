---
// Slide 11: SPOTTER-AI architecture. Genesis AI workflows -> detailed provenance capture -> R1/R2/R3.
const W = 760;
const box = (x: number, y: number, w: number, h: number) => ({ x, y, w, h, cx: x + w / 2, cy: y + h / 2 });
// R1
const r1 = { y: 196, h: 104 };
const intercept = box(70, 222, 200, 56), queries = box(290, 222, 180, 56), adaptive = box(490, 222, 250, 56);
// R2
const r2 = { y: 318, h: 112 };
const finetune = box(70, 362, 280, 52), normative = box(430, 362, 310, 52);
// R3
const r3 = { y: 448, h: 112 };
const mitre = box(70, 492, 250, 52), backward = box(345, 486, 175, 64), pruning = box(545, 486, 195, 64);
---
<figure class="arch">
  <svg viewBox={`0 0 ${W} 575`} role="img" aria-labelledby="arch-t">
    <title id="arch-t">SPOTTER-AI architecture: provenance from Genesis AI workflows feeds R1 capture, R2 normative importance and R3 automated forensics</title>
    <defs>
      <marker id="aa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="ap" /></marker>
    </defs>

    {/* Genesis AI workflows */}
    <rect x="10" y="8" width={W - 20} height="118" rx="10" class="wf" />
    <text x="30" y="42" class="wft">Genesis AI workflows</text>
    {[['Simulations', 30], ['Experiments', 200], ['Scientific data', 370], ['LLM agents & tools', 540]].map(([t, x]) => (
      <g><rect x={x as number} y="62" width="160" height="44" rx="8" class="chip" /><text x={(x as number) + 80} y="89" text-anchor="middle" class="chipt">{t}</text></g>
    ))}
    {/* provenance capture */}
    <rect x="210" y="140" width="340" height="38" rx="6" class="cap" />
    <text x="380" y="165" text-anchor="middle" class="capt">Detailed provenance capture</text>
    <path d={`M 620 126 L 620 159 L 550 159`} class="ln" marker-end="url(#aa)" />
    <path d={`M 210 159 L ${intercept.cx} 159 L ${intercept.cx} ${intercept.y - 2}`} class="ln" marker-end="url(#aa)" />

    {/* bands */}
    <rect x="10" y={r1.y} width={W - 20} height={r1.h} rx="10" class="band b1" />
    <text x="24" y={r1.y + 60} class="rlab r1">R1</text>
    <rect x="10" y={r2.y} width={W - 20} height={r2.h} rx="10" class="band b2" />
    <text x="24" y={r2.y + 66} class="rlab r2">R2</text>
    <text x="80" y={r2.y + 30} class="bandt">Transformer model</text>
    <rect x="10" y={r3.y} width={W - 20} height={r3.h} rx="10" class="band b3" />
    <text x="24" y={r3.y + 66} class="rlab r3">R3</text>
    <text x="80" y={r3.y + 30} class="bandt">Automated forensics</text>

    {/* boxes */}
    {[
      [intercept, ['Low-overhead', 'interception']],
      [queries, ['Scalable', 'queries']],
      [adaptive, ['Adaptive detail', 'capture']],
      [finetune, ['Continual fine-tuning']],
      [normative, ['Normative importance']],
      [mitre, ['MITRE attack labeling']],
      [backward, ['Backward', 'attribution']],
      [pruning, ['Agentic AI', 'pruning']],
    ].map(([b, lines]) => {
      const bb = b as ReturnType<typeof box>; const ls = lines as string[];
      return (
        <g>
          <rect x={bb.x} y={bb.y} width={bb.w} height={bb.h} rx="10" class={`bx${bb === normative ? ' key' : ''}`} />
          {ls.map((l, i) => <text x={bb.cx} y={bb.cy + 6 + (i - (ls.length - 1) / 2) * 21} text-anchor="middle" class="bxt">{l}</text>)}
        </g>
      );
    })}

    {/* arrows */}
    <path d={`M ${queries.cx} ${queries.y + queries.h} L ${queries.cx} ${normative.cy} L ${normative.x - 2} ${normative.cy}`} class="ln" marker-end="url(#aa)" />
    <path d={`M ${queries.cx} ${r2.y + 22} L 260 ${r2.y + 22} L 260 ${finetune.y - 2}`} class="ln" marker-end="url(#aa)" />
    <path d={`M ${adaptive.cx + 40} ${normative.y} L ${adaptive.cx + 40} ${adaptive.y + adaptive.h + 2}`} class="ln" marker-end="url(#aa)" />
    <path d={`M ${pruning.cx} ${normative.y + normative.h} L ${pruning.cx} ${pruning.y - 2}`} class="ln" marker-end="url(#aa)" />
    <path d={`M ${pruning.x} ${pruning.cy} L ${backward.x + backward.w + 2} ${pruning.cy}`} class="ln" marker-end="url(#aa)" />
    <path d={`M ${backward.x} ${mitre.cy} L ${mitre.x + mitre.w + 2} ${mitre.cy}`} class="ln" marker-end="url(#aa)" />
  </svg>
</figure>

<style>
  .arch { margin: 0; }
  svg { width: 100%; height: auto; display: block; font-family: var(--sans); }
  .wf { fill: #0b1f28; stroke: #2e5260; stroke-width: 1.5; }
  .wft { fill: var(--text); font-size: 22px; font-weight: 800; }
  .chip { fill: #12313d; stroke: #2e5260; } .chipt { fill: var(--muted); font-size: 14px; font-weight: 600; }
  .cap { fill: #0f2833; stroke: var(--cyan); stroke-width: 1.5; } .capt { fill: var(--text); font-size: 17px; font-weight: 700; }
  .band { stroke-width: 1.5; }
  .b1 { fill: rgba(0, 212, 219, .08); stroke: rgba(0, 212, 219, .5); }
  .b2 { fill: rgba(79, 209, 139, .08); stroke: rgba(79, 209, 139, .5); }
  .b3 { fill: rgba(78, 163, 232, .09); stroke: rgba(78, 163, 232, .55); }
  .rlab { font: 800 26px var(--mono); } .r1 { fill: var(--cyan); } .r2 { fill: #4fd18b; } .r3 { fill: #4ea3e8; }
  .bandt { fill: var(--text); font-size: 16px; font-weight: 700; }
  .bx { fill: #13303b; stroke: #3d6270; stroke-width: 1.5; }
  .bx.key { fill: #2f2a10; stroke: #d8b444; stroke-width: 2; }
  .bxt { fill: var(--text); font-size: 16px; font-weight: 700; }
  .ln { fill: none; stroke: var(--orange); stroke-width: 2.2; }
  .ap { fill: var(--orange); }
</style>
